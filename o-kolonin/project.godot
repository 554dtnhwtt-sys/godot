; Engine configuration file.
; Island Colony – pilot version. Open this folder in Godot 4.7 or later.

config_version=5

[application]

config/name="Island Colony"
config/description="Build, explore and fight with sailing ships in a Caribbean archipelago."
config/version="0.5-pilot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Data="*res://scripts/autoload/data.gd"
Game="*res://scripts/autoload/game.gd"
Art="*res://scripts/autoload/art.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.3, 0.42, 1)
textures/canvas_textures/default_texture_filter=3

[importer_defaults]

texture={
"mipmaps/generate": true
}
